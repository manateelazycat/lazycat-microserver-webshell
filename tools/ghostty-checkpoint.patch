+pub fn checkpointTheme(ptr: ?*anyopaque, config: *const GhosttyTerminalConfig) callconv(.c) void {
+    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return));
+    const colors = &wrapper.terminal.colors;
+    colors.foreground.default = if (config.fg_color == 0) null else checkpointRGB(config.fg_color);
+    colors.background.default = if (config.bg_color == 0) null else checkpointRGB(config.bg_color);
+    colors.cursor.default = if (config.cursor_color == 0) null else checkpointRGB(config.cursor_color);
+    var palette = color.default;
+    for (config.palette, 0..) |value, index| {
+        if (value != 0) palette[index] = checkpointRGB(value);
+    }
+    colors.palette.changeDefault(palette);
+    wrapper.terminal.flags.dirty.palette = true;
+    wrapper.render_state.deinit(wrapper.alloc);
+    wrapper.render_state = RenderState.empty;
+}
+
+fn checkpointRGB(value: u32) color.RGB {
+    return .{ .r = @truncate(value >> 16), .g = @truncate(value >> 8), .b = @truncate(value) };
+}
