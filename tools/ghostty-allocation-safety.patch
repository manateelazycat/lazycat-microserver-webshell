+const std = @import("std");
+
+// Numeric, fixed-size diagnostics. No allocation or terminal text on failure.
+// ABI: four header words, then eight records of 32 little-endian u32 words.
+pub const Record = extern struct {
+    stage: u32 = 0,
+    caller: u32 = 0,
+    retry: u32 = 0,
+    reason: u32 = 0,
+    source_bytes: u32 = 0,
+    target_bytes: u32 = 0,
+    source_string_bytes: u32 = 0,
+    target_string_bytes: u32 = 0,
+    source_cols: u32 = 0,
+    source_rows: u32 = 0,
+    target_cols: u32 = 0,
+    target_rows: u32 = 0,
+    uri_bytes: u32 = 0,
+    id_bytes: u32 = 0,
+    uri_offset: u32 = 0,
+    id_offset: u32 = 0,
+    metadata_valid: u32 = 0,
+    styles: u32 = 0,
+    grapheme_bytes: u32 = 0,
+    hyperlink_bytes: u32 = 0,
+    request_bytes: u32 = 0,
+    chunk_bytes: u32 = 0,
+    request_chunks: u32 = 0,
+    bitmap_words: u32 = 0,
+    free_chunks: u32 = 0,
+    largest_free_run: u32 = 0,
+    bitmap_offset: u32 = 0,
+    chunks_offset: u32 = 0,
+    reserved0: u32 = 0,
+    reserved1: u32 = 0,
+    reserved2: u32 = 0,
+    reserved3: u32 = 0,
+};
+const Report = extern struct {
+    version: u32 = 1,
+    operation: u32 = 0,
+    count: u32 = 0,
+    total: u32 = 0,
+    entries: [8]Record = @splat(.{}),
+};
+var report: Report = .{};
+pub var context: Record = .{};
+var active = false;
+var invalid_metadata = false;
+
+pub fn word(value: usize) u32 {
+    return @intCast(@min(value, std.math.maxInt(u32)));
+}
+pub fn begin(operation: u32) void {
+    report.operation = operation;
+    report.count = 0;
+    report.total = 0;
+    context = .{};
+    active = true;
+    invalid_metadata = false;
+}
+pub fn finish() void {
+    active = false;
+}
+pub fn ptr() callconv(.c) usize {
+    return @intFromPtr(&report);
+}
+pub fn len() callconv(.c) usize {
+    return @sizeOf(Report);
+}
+pub fn invalidMetadata() bool {
+    return invalid_metadata;
+}
+pub fn append(entry: Record) void {
+    if (!active) return;
+    report.total +|= 1;
+    if (report.count < report.entries.len) {
+        report.entries[report.count] = entry;
+        report.count += 1;
+    } else {
+        // Preserve the first failure and the seven newest observations.
+        for (1..7) |i| report.entries[i] = report.entries[i + 1];
+        report.entries[7] = entry;
+    }
+}
+pub fn invalidLink() void {
+    if (!active) return;
+    invalid_metadata = true;
+    var entry = context;
+    entry.reason = 2;
+    entry.metadata_valid = 0;
+    append(entry);
+}
+pub fn allocationFailed(chunk_bytes: usize, request_bytes: usize, chunks: usize, bitmaps: []const u64, bitmap_offset: usize, chunks_offset: usize) void {
+    if (!active) return;
+    var entry = context;
+    entry.reason = 1;
+    entry.request_bytes = word(request_bytes);
+    entry.chunk_bytes = word(chunk_bytes);
+    entry.request_chunks = word(chunks);
+    entry.bitmap_words = word(bitmaps.len);
+    entry.bitmap_offset = word(bitmap_offset);
+    entry.chunks_offset = word(chunks_offset);
+    var free: usize = 0;
+    var run: usize = 0;
+    var largest: usize = 0;
+    for (bitmaps) |bitmap| {
+        free += @popCount(bitmap);
+        if (bitmap == std.math.maxInt(u64)) {
+            run += 64;
+        } else {
+            largest = @max(largest, run + @ctz(~bitmap));
+            run = @clz(~bitmap);
+            var bits = bitmap;
+            var local: usize = 0;
+            while (bits != 0) : (local += 1) bits &= bits << 1;
+            largest = @max(largest, local);
+        }
+        largest = @max(largest, run);
+    }
+    entry.free_chunks = word(free);
+    entry.largest_free_run = word(largest);
+    append(entry);
+}
