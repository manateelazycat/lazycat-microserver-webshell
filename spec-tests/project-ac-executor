#!/usr/bin/env python3
"""The sole spec-executor.v1 boundary; spec-tests owns real environment behavior."""
from __future__ import annotations
import argparse
import json
import math
from pathlib import Path
import signal
import subprocess
import sys
from uuid import uuid4

ROOT = Path(__file__).resolve().parents[1]
REGISTRY = ROOT / 'spec-tests/ac-implementations.json'
TESTS_ROOT = ROOT / 'spec-tests'


def emit(value):
    print(json.dumps(value, ensure_ascii=False, separators=(',', ':')), flush=True)


class Parser(argparse.ArgumentParser):
    def error(self, message):
        # Argument values can contain credentials. Name the problem without echoing them.
        raise ValueError('Invalid executor parameters; consult ./run-ac.sh --help')


def arguments(argv):
    parser = Parser(add_help=False)
    parser.add_argument('--action', required=True, choices=('help', 'discover', 'run'))
    parser.add_argument('--scenarios-file')
    parser.add_argument('--url')
    parser.add_argument('--env-file')
    parser.add_argument('--timeout', type=float, default=300)
    parser.add_argument('--target', choices=('desktop-browser', 'android-emulator'), default='desktop-browser')
    args = parser.parse_args(argv)
    if not math.isfinite(args.timeout) or not 1 <= args.timeout <= 3600:
        raise ValueError('--timeout must be between 1 and 3600 seconds')
    return args


def registry():
    data = json.loads(REGISTRY.read_text())
    if not isinstance(data, dict):
        raise ValueError('Invalid AC implementation registry')
    for scenario, implementation in data.items():
        filename = implementation.get('test_id') or implementation.get('android_test_id')
        if not filename or len(scenario.split('/')) != 3 or Path(filename).is_absolute() or '..' in Path(filename).parts:
            raise ValueError('Invalid scenario or test_id in registry')
        desktop = implementation.get('test_id')
        if desktop and (Path(desktop).is_absolute() or '..' in Path(desktop).parts):
            raise ValueError('Invalid test_id in registry')
        if not implementation.get('steps') or not all(isinstance(step, str) for step in implementation['steps']):
            raise ValueError('Registry requires complete contract steps')
        android = implementation.get('android_test_id')
        android_name = Path(android).name if android else ''
        if android and (Path(android).is_absolute() or '..' in Path(android).parts or
                        not (android_name == 'android.mjs' or
                             (android_name.startswith('android-') and android_name.endswith('.mjs')))):
            raise ValueError('Invalid android_test_id in registry')
        if implementation.get('coverage_status') not in (None, 'pending'):
            raise ValueError('Invalid coverage_status in registry')
        if implementation.get('android_status') not in (None, 'pending'):
            raise ValueError('Invalid android_status in registry')
    return data


def environment_options(args):
    options = []
    for flag, value in [('--url', args.url), ('--env-file', args.env_file)]:
        if value is not None:
            options += [flag, value]
    return options


def run_selected(args, implementations):
    if not args.scenarios_file:
        raise ValueError('--scenarios-file is required for run')
    payload = json.loads(Path(args.scenarios_file).read_text())
    selected = payload.get('scenarios')
    if not isinstance(selected, list) or not selected:
        raise ValueError('Selection must contain at least one scenario')
    seen = set()
    for item in selected:
        scenario = item.get('global_id')
        if scenario in seen or scenario not in implementations:
            raise ValueError('Selection contains duplicate or unimplemented scenarios')
        seen.add(scenario)
        if [step.get('message') for step in item.get('steps', [])] != implementations[scenario]['steps']:
            raise ValueError('AC steps changed; review the module mapping before running')
        implementation = implementations[scenario]
        if implementation.get('coverage_status') == 'pending':
            raise ValueError(f'Scenario test coverage is pending: {scenario}')
        if args.target == 'android-emulator' and not implementation.get('android_test_id'):
            raise ValueError(f'Android scenario is not implemented: {scenario}')
        if args.target == 'android-emulator' and implementation.get('android_status') == 'pending':
            raise ValueError(f'Android scenario is pending: {scenario}: {implementation.get("android_reason", "missing condition")}')
        if args.target == 'desktop-browser' and not implementation.get('test_id'):
            raise ValueError(f'Desktop scenario is not implemented: {scenario}')
        item['test_id'] = implementation['android_test_id'] if args.target == 'android-emulator' else implementation['test_id']
    tests = TESTS_ROOT
    suite = tests / ('android-suite.mjs' if args.target == 'android-emulator' else 'test-all.sh')
    if not suite.is_file():
        raise ValueError('spec-tests/test-all.sh is unavailable')
    report_dir = ROOT / 'spec-tests/reports' / uuid4().hex
    report_dir.mkdir(parents=True)
    selection = report_dir / 'selection.json'
    selection.write_text(json.dumps(payload, ensure_ascii=False, indent=2))
    # One project-level orchestration, including for an exact selector.
    # stderr is inherited so AC_PROGRESS reaches run-ac while the suite runs.
    runner = [str(suite)] if args.target == 'desktop-browser' else ['node', str(suite)]
    child = subprocess.Popen([*(['bash'] if args.target == 'desktop-browser' else []), *runner, '--scenarios-file', str(selection),
        '--artifacts-dir', str(report_dir), '--timeout', str(args.timeout), '--json',
        *environment_options(args)], cwd=tests, stdout=subprocess.PIPE, text=True)
    try:
        output, _ = child.communicate()
    except KeyboardInterrupt:
        child.send_signal(signal.SIGINT)
        output, _ = child.communicate()
    try:
        response = json.loads(output)
    except ValueError:
        raise ValueError('test-all.sh did not return a structured suite result')
    (report_dir / 'executor.json').write_text(json.dumps(response, ensure_ascii=False, indent=2))
    results = response.get('results')
    if not isinstance(results, list) or response.get('status') not in ('passed', 'failed'):
        raise ValueError('Invalid suite response')
    if not results and response.get('status') == 'failed':
        emit(response)
        return 1
    if len(results) != len(seen) or {item.get('scenario') for item in results} != seen:
        raise ValueError('Suite results do not cover the exact selected ACs')
    for item in results:
        if item.get('status') not in ('passed', 'failed', 'skipped'):
            raise ValueError('Invalid module status')
        expected_test = implementations[item['scenario']]['android_test_id'] if args.target == 'android-emulator' else implementations[item['scenario']]['test_id']
        if item.get('test_id') != expected_test:
            raise ValueError('Suite result does not match its module')
    passed = all(item['status'] == 'passed' for item in results)
    if (child.returncode == 0) != passed or (response['status'] == 'passed') != passed:
        raise ValueError('Suite status and exit code disagree')
    emit(response)
    return 0 if passed else 1


def main(argv):
    try:
        args = arguments(argv)
        if args.action == 'help':
            emit({'description': 'Run selected WebShell ACs in the desktop browser or the allocated Android LightOS app.', 'options': [
                {'name': '--url', 'value': '<url>', 'description': 'Authorized WebShell target; otherwise WEBSHELL_TEST_URL'},
                {'name': '--env-file', 'value': '<path>', 'description': 'Local uncommitted environment file; shell variables take precedence'},
                {'name': '--timeout', 'value': '<seconds>', 'description': 'Per-scenario deadline including setup', 'default': '300'},
                {'name': '--target', 'value': '<desktop-browser|android-emulator>', 'description': 'Execution target', 'default': 'desktop-browser'}]})
            return 0
        implementations = registry()
        if args.action == 'discover':
            # Do not probe credentials, targets or project options during discovery.
            discovery_root = TESTS_ROOT
            paths = [name for item in implementations.values() for name in
                     (item.get('test_id'), item.get('android_test_id')) if name]
            missing = [name for name in paths if not (discovery_root / name).is_file()]
            if missing:
                raise ValueError('Registered scenario files are missing from spec-tests')
            discovered = set()
            spec_root = ROOT / 'spec'
            for ac in spec_root.glob('*/*/AC.md'):
                testdir = discovery_root / ac.parent.parent.name / ac.parent.name
                if not testdir.is_dir():
                    continue
                for script in testdir.glob('*.mjs'):
                    if script.name == 'helpers.mjs':
                        continue
                    discovered.add(str(script.relative_to(discovery_root)))
            registered = [item['test_id'] for item in implementations.values() if item.get('test_id')]
            android_registered = [item['android_test_id'] for item in implementations.values() if item.get('android_test_id')]
            if len(set(registered)) != len(registered) or len(set(android_registered)) != len(android_registered) or discovered != set(registered + android_registered):
                raise ValueError('spec-tests modules and AC registry differ; add the missing module REQ/AC and mapping instead of silently omitting tests')
            emit({'status': 'passed', 'implementations': [{'scenario': scenario, 'test_id': item['test_id']}
                for scenario, item in sorted(implementations.items()) if item.get('coverage_status') != 'pending' and item.get('test_id')] +
                [{'scenario': scenario, 'test_id': item['android_test_id']}
                 for scenario, item in sorted(implementations.items()) if item.get('coverage_status') != 'pending' and not item.get('test_id')]})
            return 0
        return run_selected(args, implementations)
    except (ValueError, OSError, KeyError, TypeError) as error:
        # Never expose raw JSON documents, command lines or secret file contents.
        message = str(error) if type(error) is ValueError else 'Executor configuration or environment is invalid; check paths and registry'
        print(message, file=sys.stderr)
        emit({'status': 'failed', 'results': [], 'error': message})
        return 1


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
