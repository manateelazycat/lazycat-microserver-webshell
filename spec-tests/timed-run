#!/usr/bin/env python3
"""Report end-to-end test time once, for interactive and redirected runs."""
import json
import os
import signal
import subprocess
import sys
import time

command = sys.argv[1:]
if not command:
    raise SystemExit('timed-run requires a command')
query = any(arg in ('--help', '-h', '--version', '--dry-run') for arg in command[1:])
if os.environ.get('WEBSHELL_TIMING_OWNER') or query or os.environ.get('TESTS_AUTO_DRY_RUN') == '1':
    os.execvp(command[0], command)

started = time.monotonic()
json_mode = '--json' in command[1:]
environment = {**os.environ, 'WEBSHELL_TIMING_OWNER': 'entrypoint'}
child = None
exit_code = 1
elapsed_ms = None


def forward(signum, _frame):
    if child is not None and child.poll() is None:
        try:
            os.killpg(child.pid, signum)
        except ProcessLookupError:
            pass


signal.signal(signal.SIGINT, forward)
signal.signal(signal.SIGTERM, forward)
try:
    child = subprocess.Popen(command, env=environment, start_new_session=True,
                             stdout=subprocess.PIPE if json_mode else None, text=True)
    output, _ = child.communicate()
    exit_code = child.returncode if child.returncode >= 0 else 128 - child.returncode
    elapsed_ms = round((time.monotonic() - started) * 1000)
    elapsed = elapsed_ms / 1000
    if json_mode and output:
        try:
            result = json.loads(output)
            if not isinstance(result, dict):
                raise ValueError('Expected a JSON result object')
            result['duration_seconds'] = elapsed
            if isinstance(result.get('summary'), dict):
                result['summary']['duration_seconds'] = elapsed
            print(json.dumps(result, ensure_ascii=False, indent=2), flush=True)
        except ValueError:
            # Preserve the command's diagnostic output and its original exit code.
            sys.stdout.write(output)
            sys.stdout.flush()
except OSError as error:
    print(f'Cannot start test entrypoint: {error.strerror}', file=sys.stderr, flush=True)
finally:
    milliseconds = elapsed_ms if elapsed_ms is not None else round((time.monotonic() - started) * 1000)
    hours, rest = divmod(milliseconds, 3600000)
    minutes, rest = divmod(rest, 60000)
    prefix = f'{hours} 小时 ' if hours else ''
    print(f'测试总用时：{prefix}{minutes} 分 {rest / 1000:.3f} 秒（{milliseconds / 1000:.3f}s）',
          file=sys.stderr if json_mode else sys.stdout, flush=True)
raise SystemExit(exit_code)
