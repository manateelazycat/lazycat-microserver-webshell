# Copy to an uncommitted file and pass its absolute path using --env-file
# or WEBSHELL_TEST_ENV_FILE. Values are literal; shell code is never evaluated.
WEBSHELL_TEST_URL=
WEBSHELL_TEST_USERNAME=
WEBSHELL_TEST_PASSWORD=
# Frontend builds are prepared automatically by the test entrypoint.
TEST_FOREGROUND=1
PW_CHANNEL=chrome
# Set exactly one Android selector when authoring/running Android flows.
WEBSHELL_ANDROID_SERIAL=
WEBSHELL_ANDROID_DEVICE=

# Device-hub MCP. Bind the exact allocated Android emulator and reuse the
# same cooperative owner label for every run in this test session.
WEBSHELL_DEVICE_MCP_URL=http://<device-hub-host>:<port>/mcp
WEBSHELL_DEVICE_MCP_OWNER=
WEBSHELL_DEVICE_NAME=Pixel 9 Pro
WEBSHELL_DEVICE_KIND=emulator

# X11 display for the default visible Chrome windows.
DISPLAY=:0
# Optional uncommitted authenticated browser state.
WEBSHELL_TEST_STORAGE_STATE=
