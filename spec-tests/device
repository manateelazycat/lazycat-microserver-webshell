#!/usr/bin/env node
import { spawn } from "node:child_process";
import path from "node:path";
import { deviceConfiguration } from "./environment/agent-device.mjs";
import { projectRoot } from "./environment/config.mjs";

const args = process.argv.slice(2);
const informational = args[0] === "help" || args.includes("--help") || args.includes("--version");
if (!informational && args.some((arg) => ["open", "replay", "test", "batch", "mcp"].includes(arg))) {
  console.error("CURRENT_LOCAL_FRONTEND_UNAVAILABLE: agent-device test execution requires a verified local frontend channel; device setup/discovery remains available");
  process.exit(1);
}
const { config, env } = await deviceConfiguration();
const child = spawn(path.join(projectRoot, "node_modules/.bin/agent-device"),
  process.argv.slice(2), { cwd: projectRoot, env, stdio: "inherit" });
process.once("SIGINT", () => child.kill("SIGINT"));
process.once("SIGTERM", () => child.kill("SIGTERM"));
child.once("error", () => { console.error("agent-device could not start; run npm ci in spec-tests"); process.exitCode = 1; });
child.once("exit", (code) => { process.exitCode = code ?? 1; });
